@page "/client-location"
@using MauiSharedApp.Shared.Services
@using MauiSharedApp.Shared.Models
@inject IGeolocationService GeolocationService
@inject ICustomerApiService CustomerApiService
@inject IJSRuntime JS

<PageTitle>Client Location</PageTitle>

<h1>Client Location</h1>

@if (GeolocationService.IsSupportedPlatform())
{
    <button class="btn btn-primary" @onclick="GetClientLocation">Get Location</button>
    <div class="mt-2">
        Lat: @clientLocation?.Latitude &nbsp;
        Lon: @clientLocation?.Longitude
    </div>
    <div class="mt-2">
        Radius (km): <input type="number" step="0.1" @bind="radiusKm" style="width:80px" />
        <button class="btn btn-success ms-2" @onclick="FindCustomersWithinRadius">Find Customers Within Radius</button>
    </div>

    @if (isLoading)
    {
        <p class="mt-2"><em>Loading...</em></p>
    }
    else if (customersWithinRadius is not null)
    {
        <div class="mt-2">
            <strong>@customersWithinRadius.Count customer(s) within @radiusKm km:</strong>
            <ul>
                @foreach (var item in customersWithinRadius)
                {
                    <li>
                        @item.Customer.Name — @item.DistanceKm.ToString("F2") km
                        @if (item.Customer.Sales is not null)
                        {
                            <span> (Sales: @item.Customer.Sales.Name)</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
}
else
{
    <p>Your platform is not supported for geolocation.</p>
}

@if (GeolocationService.IsGeocodingSupported())
{
    <div>
        Lat: <input type="text" @bind="clientLocation.Latitude" />
        Lon: <input type="text" @bind="clientLocation.Longitude" />
        <button class="btn btn-primary" @onclick="GetGeocode">Get Geocode</button>
    </div>
}
else
{
    <p>Your platform is not supported for geocoding.</p>
}

@code {
    private GeoLoc clientLocation = new GeoLoc();
    private double radiusKm = 5.0;
    private bool isLoading;
    private List<CustomerWithDistanceDto>? customersWithinRadius;

    //get the client location
    private async Task GetClientLocation()
    {
        try
        {
            var location = await GeolocationService.GetCurrentLocationAsync();
            if (location != null)
            {
                clientLocation = new GeoLoc
                {
                    Latitude = location.Latitude,
                    Longitude = location.Longitude
                };
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error getting location: {ex.Message}");
        }
    }

    //get geocode
    private async Task GetGeocode()
    {
        try
        {
            var geocode = await GeolocationService.GetAddressFromCoordinatesAsync(clientLocation.Latitude, clientLocation.Longitude);
            if (geocode != null)
            {
                await JS.InvokeVoidAsync("alert", $"Address: {geocode}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error getting geocode: {ex.Message}");
        }
    }

    // Ambil daftar customer dalam radius tertentu dari API.
    // Filtering (bounding box + Haversine) sepenuhnya dilakukan di server (MauiSharedApp.API).
    private async Task FindCustomersWithinRadius()
    {
        if (clientLocation == null)
        {
            await JS.InvokeVoidAsync("alert", "Client location is not available.");
            return;
        }

        isLoading = true;
        try
        {
            customersWithinRadius = await CustomerApiService.GetNearbyCustomersAsync(
                clientLocation.Latitude, clientLocation.Longitude, radiusKm);

            if (customersWithinRadius.Count == 0)
            {
                await JS.InvokeVoidAsync("alert", $"Tidak ada customer dalam radius {radiusKm} km.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error fetching nearby customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
